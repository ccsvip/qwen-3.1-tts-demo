# 复制为 backend/.env 后填写。backend/.env 含密钥，不要提交。
DASHSCOPE_API_KEY=

# 业务空间 ID。填写后请求发往 https://{WORKSPACE_ID}.cn-beijing.maas.aliyuncs.com/api/v1
WORKSPACE_ID=

# 可选。填写后覆盖上面的地址，需包含 /api/v1，末尾不要斜杠。
DASHSCOPE_BASE_URL=

# 本地上传复刻音频时，百炼要能从公网拉取这个地址下的 /media/ 文件。
# 例：https://your-tunnel.example.com
# 留空时请改用公网音频 URL 复刻。
PUBLIC_BASE_URL=
